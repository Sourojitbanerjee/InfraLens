{
  "name": "infralens",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "test": "esbuild tests/accuracyEvaluation.test.ts --bundle --platform=node --outfile=tests/accuracyEvaluation.bundle.cjs && node --test tests/accuracyEvaluation.bundle.cjs",
    "eval": "esbuild scripts/evaluate-accuracy.ts --bundle --platform=node --outfile=scripts/evaluate-accuracy.bundle.cjs && node scripts/evaluate-accuracy.bundle.cjs",
    "server": "esbuild server/index.ts --bundle --platform=node --outfile=server/server.bundle.cjs && node server/server.bundle.cjs",
    "ml-server": ".venv/bin/python3 server/ml_inference_service.py --serve"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.14",
    "@types/node": "^22.8.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^5.4.10"
  }
}
